{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd social-fabric-shop && npm ci",
  "buildCommand": "cd social-fabric-shop && npm run build",
  "outputDirectory": "social-fabric-shop/dist",
  "framework": null,
  "rewrites": [
    { "source": "/shop", "destination": "/shop.html" },
    { "source": "/models", "destination": "/models.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/cart", "destination": "/cart.html" },
    { "source": "/checkout", "destination": "/checkout.html" },
    { "source": "/delivery", "destination": "/delivery.html" },
    { "source": "/product", "destination": "/product.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ]
}
